# Copy to .env.local (gitignored) and fill in. `make env-example` does this.
#
# Shown here with R2 values. For AWS S3: drop RUNNER_S3_ENDPOINT, set
# AWS_DEFAULT_REGION to a real region, and RUNNER_S3_PATH_STYLE=false.

# --- queue ------------------------------------------------------------------
RUNNER_CF_ACCOUNT_ID=
RUNNER_QUEUE_ID=
# Needs Queues Read *and* Write — ack needs write.
RUNNER_QUEUE_API_TOKEN=

# --- storage ----------------------------------------------------------------
RUNNER_BUCKET=video
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
RUNNER_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
RUNNER_S3_PATH_STYLE=true

# --- layout -----------------------------------------------------------------
RUNNER_SOURCE_PREFIX=source/
RUNNER_OUTPUT_PREFIX=media/

# --- processing -------------------------------------------------------------
RUNNER_CONCURRENCY=1

# --- webhook (optional; both or neither) ------------------------------------
# RUNNER_WEBHOOK_URL=https://app.example.com/hooks/video
# RUNNER_WEBHOOK_SECRET=
